rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsUserTree(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Each learner can read/write only their own TKT Ready data.
    // Admin/teacher roles can be added later with custom claims if needed.
    match /users/{userId} {
      allow read, write: if ownsUserTree(userId);

      match /{document=**} {
        allow read, write: if ownsUserTree(userId);
      }
    }
  }
}
